# Development Dockerfile for Night Sky Navigator
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code (but exclude node_modules via .dockerignore)
COPY . .

# Ensure npm binaries are properly linked
RUN npm rebuild

# Create certificates directory
RUN mkdir -p /app/certs

# Expose ports for development server (HTTP and HTTPS)
EXPOSE 3000 3001

# Default command to start development server
CMD ["npm", "run", "dev:https"]